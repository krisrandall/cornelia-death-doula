---
import Base from '../layouts/Base.astro';
import { href } from '../site';
---

<Base title="Page not found">
  <header class="pagehead">
    <div class="wrap">
      <h1>That page isn’t here</h1>
      <p class="lede">
        Which is a small loss on a site about larger ones. Try the
        <a href={href('/')}>home page</a>, or just <a href={href('/contact')}>write to me</a>.
      </p>
    </div>
  </header>
</Base>
